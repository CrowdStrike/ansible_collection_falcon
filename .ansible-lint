---
exclude_paths:
  - ".[dgc]*"
  - ".ansible/collections/" # Exclude duplicate processing of installed collections
  - "tests/container-env/" # Exclude container test environment files

enable_list:
  - fqcn-builtins # opt-in

skip_list:
  - "var-naming[no-role-prefix]"
  - "run-once[task]"

# Keep this key: without it ansible-lint falls back to its default warn_list,
# which downgrades experimental rules such as args[module] to warnings.
warn_list: []
